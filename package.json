{
  "name": "caching",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learning caching in TypeScript — build one from scratch, then use Redis, with real patterns and pitfalls.",
  "scripts": {
    "phase1": "node src/phase1/demo.ts",
