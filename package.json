    "phase3": "node src/phase3/cache-aside.ts",
    "phase4": "node src/phase4/write-patterns.ts",
    "phase5": "node src/phase5/stampede.ts",
    "phase6": "node src/phase6/consistency.ts",
    "phase7": "node src/phase7/consistent-hashing.ts",
    "phase8": "node src/phase8/hot-keys.ts",
    "phase9": "node src/phase9/probabilistic-expiration.ts",
    "phase10": "node src/phase10/eviction-policies.ts",
    "phase11": "node src/phase11/penetration-bloom.ts",
    "phase12": "node src/phase12/sizing.ts",
    "phase13": "node src/phase13/cache-down-resilience.ts",
    "phase14": "node src/phase14/flash-sale.ts",
    "phase15": "node src/phase15/leaderboard.ts",
    "web": "node web/serve.mjs",
